[Unit]
Description=Send SKM website contact requests by email
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=skm_site_mail
Group=skm_site_mail
Environment=PGHOST=/var/run/postgresql PGDATABASE=skm_site PGUSER=skm_site_mail PGCONNECT_TIMEOUT=5 PGCLIENTENCODING=UTF8
Environment=SKM_CONTACT_SMTP_USER=i@ooo-skmoscow.ru SKM_CONTACT_MAIL_TO=i@ooo-skmoscow.ru
LoadCredential=smtp-password:/etc/skm-site-mail/smtp-password
ExecStart=/usr/bin/python3 /opt/skm-site-mail/contact-mailer.py
TimeoutStartSec=4min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
